@{var r=(AiReport)ViewBag.Report;var snap=(FarmSnapshot)ViewBag.Snapshot;var content=(FarmAI.Services.AiContent?)ViewBag.Content;ViewData["Title"]="Báo cáo tổng hợp";}
<a asp-action="Index">← Trở về báo cáo</a><h1>Bản dự thảo từ @r.Provider</h1><p class="lead">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Kỳ @snap.PeriodStart – @snap.PeriodEnd · <span class="pill @(r.Status=="DRAFT"?"warn":"")">@r.Status</span></p>
<div class="warning"><strong>⚠ Khuyến nghị từ AI chỉ mang tính tham khảo, không thay thế cho bác sĩ thú y.</strong></div>
<section class="panel"><h2>Tổng quan</h2><p>@content?.summary</p><h3>Nhận xét và nguồn</h3>@if(content?.observations!=null){@foreach(var o in content.observations){<div class="note" style="margin-bottom:12px"><p>@o.text</p><small class="mono">Nguồn: @string.Join(", ",o.source_ids)</small></div>}}<h3>Dữ liệu thiếu</h3><p>@string.Join(", ",content?.missing_data??new())</p><h3>Giới hạn so sánh</h3><p>@string.Join("; ",content?.limitations??new())</p></section>
<section class="panel"><h2>Dữ liệu gốc đã chốt</h2><p class="mono">Snapshot ID: @snap.Id · SHA256: @snap.Checksum</p><pre>@snap.DataJson</pre></section>
@if(r.Status=="DRAFT"&&!User.IsInRole(Roles.Employee)){<section class="panel"><h2>Phê duyệt sau khi đối chiếu nguồn</h2><form asp-action="Approve" method="post"><input name="id" type="hidden" value="@r.Id"/><input name="version" type="hidden" value="@r.Version"/><button>Đã kiểm tra và phê duyệt</button></form></section>}

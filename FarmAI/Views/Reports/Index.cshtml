@{ViewData["Title"]="Báo cáo & AI";var herds=(List<Herd>)ViewBag.Herds;var outputs=(List<AiReport>)ViewBag.Reports;}
<h1>Dashboard, snapshot và báo cáo AI</h1><p class="lead">Các chỉ số do máy chủ tính; AI chỉ diễn giải và luôn lưu nháp chờ phê duyệt.</p>
<section class="panel"><h2>Thống kê theo kỳ</h2><form asp-action="Index" method="get" class="action-row"><label>Từ ngày<input type="date" name="start" value="@ViewBag.Start.ToString("yyyy-MM-dd")" /></label><label>Đến ngày<input type="date" name="end" value="@ViewBag.End.ToString("yyyy-MM-dd")" /></label><button class="light">Tính lại</button></form><pre>@ViewBag.Dashboard</pre><p class="subtle">Các số liệu và kỳ tính hiển thị theo dữ liệu gốc; doanh số và tiền thu chỉ dành cho quản lý.</p></section>
@if(!User.IsInRole(Roles.Employee)){<section class="panel"><h2>Tạo bản dự thảo AI hoặc báo cáo theo quy tắc</h2><form asp-action="Generate" method="post"><div class="form-grid"><label>Đàn<select name="herdId">@foreach(var h in herds){<option value="@h.Id">@h.Code</option>}</select></label><label>Tác vụ<select name="task"><option value="growth_report">Báo cáo tăng trưởng</option><option value="herd_summary">Tóm tắt đàn</option><option value="reminder">Nhắc lịch</option></select></label><label>Từ ngày<input type="date" name="start" value="@ViewBag.Start.ToString("yyyy-MM-dd")" /></label><label>Đến ngày<input type="date" name="end" value="@ViewBag.End.ToString("yyyy-MM-dd")" /></label></div><button>Tạo bản dự thảo</button></form><p class="note">@ViewBag.AiReportMode</p></section>}
<section class="panel"><h2>Lịch sử báo cáo</h2><div class="table-wrap"><table><thead><tr><th>Ngày tạo</th><th>Nguồn xử lý</th><th>Model</th><th>Trạng thái</th><th>Xem</th></tr></thead><tbody>@foreach(var r in outputs){<tr><td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@r.Provider</td><td>@r.Model</td><td><span class="pill @(r.Status=="DRAFT"?"warn":"")">@r.Status</span></td><td><a asp-action="Details" asp-route-id="@r.Id">Chi tiết →</a></td></tr>}</tbody></table></div></section>

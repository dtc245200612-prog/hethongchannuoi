@{ViewData["Title"]="Tăng trưởng";var herds=(List<Herd>)ViewBag.Herds;var records=(List<GrowthRecord>)ViewBag.Records;}
<h1>Ghi cân đo và theo dõi tăng trưởng</h1><p class="lead">Khối lượng bình quân từ cỡ mẫu; ADG chỉ tính với phương pháp phù hợp.</p>
<section class="panel"><h2>Ghi một lần cân</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Đàn<select name="HerdId">@foreach(var h in herds){<option value="@h.Id" selected="@(h.Id==ViewBag.Selected)">@h.Code</option>}</select></label><label>Số con cân<input name="SampleSize" type="number" min="1" required /></label><label>Tổng khối lượng (kg)<input name="WeightKg" type="number" min="0.001" step="0.001" required/></label><label>Phương pháp<select name="Method"><option value="RANDOM">Lấy mẫu ngẫu nhiên</option><option value="FULL">Toàn đàn</option><option value="TARGETED">Theo nhóm chọn</option></select></label><label>Thời điểm UTC<input type="datetime-local" name="MeasuredAt" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" /></label></div><button>Ghi cân</button></form></section>
<section class="panel"><div class="row between"><h2>Chuỗi cân</h2><form method="get" asp-action="Index" class="inline"><select name="herdId">@foreach(var h in herds){<option value="@h.Id" selected="@(h.Id==ViewBag.Selected)">@h.Code</option>}</select><button class="light">Xem</button></form></div>
@if(ViewBag.ADG is decimal adg){<div class="stat"><label>ADG giữa hai lần gần nhất</label><strong>@adg.ToString("N3") kg/ngày</strong></div>}else{<p class="note">ADG chưa đủ căn cứ (thiếu lần cân hoặc phương pháp/thời gian không thể so sánh).</p>}
<div class="table-wrap"><table><thead><tr><th>Ngày cân</th><th>Số mẫu</th><th>Tổng kg</th><th>Bình quân kg/con</th><th>Phương pháp</th></tr></thead><tbody>@foreach(var r in records){<tr><td>@r.MeasuredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@r.SampleSize</td><td>@r.WeightKg</td><td>@r.AverageKg</td><td>@r.Method</td></tr>}</tbody></table></div></section>

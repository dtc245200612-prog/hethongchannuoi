@model GenericHerdFormViewModel<CareSchedule>
@{ ViewData["Title"] = "Lập lịch chăm sóc"; }
<article class="panel form-card"><form asp-action="CreateSchedule" method="post">
<div asp-validation-summary="ModelOnly"></div><div class="form-grid">
<div class="field"><label asp-for="Item.HerdId"></label><select asp-for="Item.HerdId" asp-items="Model.Herds"><option value="">-- Chọn đàn --</option></select></div>
<div class="field"><label asp-for="Item.ScheduledDate"></label><input asp-for="Item.ScheduledDate" /></div>
<div class="field full"><label asp-for="Item.Title"></label><input asp-for="Item.Title" placeholder="Ví dụ: Vệ sinh máng uống định kỳ" /></div>
<div class="field"><label asp-for="Item.Assignee"></label><input asp-for="Item.Assignee" /></div>
<div class="field full"><label asp-for="Item.Notes"></label><textarea asp-for="Item.Notes"></textarea></div>
</div>
<div class="form-actions"><button class="btn btn-primary">Lưu lịch chăm sóc</button><a class="btn btn-outline" asp-action="Index">Hủy</a></div>
</form></article>

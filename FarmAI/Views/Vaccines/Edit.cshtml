@model GenericHerdFormViewModel<VaccineRecord>
@{
    ViewData["Title"] = "Cập nhật lịch tiêm phòng";
}
<article class="panel form-card">
<form asp-action="Edit" asp-route-id="@Model.Item.Id" method="post">
<input asp-for="Item.Id" type="hidden" />
<input asp-for="Item.Status" type="hidden" />
<div asp-validation-summary="ModelOnly"></div>
<div class="form-grid">
<div class="field"><label asp-for="Item.HerdId"></label><select asp-for="Item.HerdId" asp-items="Model.Herds"></select></div>
<div class="field"><label asp-for="Item.VaccineName"></label><input asp-for="Item.VaccineName" /></div>
<div class="field"><label asp-for="Item.ScheduledDate"></label><input asp-for="Item.ScheduledDate" /></div>
<div class="field"><label asp-for="Item.CompletedDate"></label><input asp-for="Item.CompletedDate" /></div>
<div class="field full"><label asp-for="Item.Notes"></label><textarea asp-for="Item.Notes"></textarea></div>
</div>
<div class="form-actions"><button class="btn btn-primary">Lưu thay đổi</button><a class="btn btn-outline" asp-action="Index">Quay lại</a></div>
</form>
</article>

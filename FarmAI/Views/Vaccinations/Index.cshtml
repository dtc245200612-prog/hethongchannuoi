@{ViewData["Title"]="Tiêm phòng";var herds=(List<Herd>)ViewBag.Herds;var vaccines=(List<Vaccine>)ViewBag.Vaccines;var plans=(List<VaccinationPlan>)ViewBag.Plans;var events=(List<VaccinationEvent>)ViewBag.Events;var users=(List<AppUser>)ViewBag.Users;}
<div class="row between"><div><h1>Lịch tiêm phòng và cảnh báo</h1><p class="lead">Tách mục tiêu, lần thực hiện và số lượng đã duyệt.</p></div><form asp-action="Refresh" method="post"><button class="light">↻ Cập nhật cảnh báo</button></form></div>
@if(!User.IsInRole(Roles.Employee)){<section class="panel"><h2>Lập kế hoạch tiêm</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Đàn<select name="HerdId">@foreach(var h in herds){<option value="@h.Id">@h.Code</option>}</select></label><label>Vaccine<select name="VaccineId">@foreach(var v in vaccines){<option value="@v.Id">@v.Name</option>}</select></label><label>Ngày dự kiến<input type="date" name="PlannedDate" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" /></label><label>Mục tiêu (con)<input type="number" min="1" name="Target" required/></label><label>Người phụ trách<select name="AssignedTo">@foreach(var u in users){<option value="@u.Id">@u.Username</option>}</select></label><label>Căn cứ chuyên môn<input name="Reference" required /></label></div><button>Tạo lịch</button></form></section>}
<section class="panel"><h2>Danh sách kế hoạch</h2><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Đàn</th><th>Vaccine</th><th>Mục tiêu</th><th>Đã duyệt</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>@foreach(var p in plans){var done=events.Where(x=>x.PlanId==p.Id&&x.ApprovedBy!=null).Sum(x=>x.Quantity);<tr><td>@p.PlannedDate.ToString("dd/MM/yyyy")</td><td>@(herds.FirstOrDefault(h=>h.Id==p.HerdId)?.Code ?? "-")</td><td>@(vaccines.FirstOrDefault(v=>v.Id==p.VaccineId)?.Name ?? "-")</td><td>@p.Target</td><td>@done</td><td><span class="pill @(p.Status=="COMPLETED"?"":"warn")">@p.Status</span></td><td>@if(p.Status is "PLANNED" or "PARTIAL"){<form asp-action="Submit" method="post" class="action-row"><input type="hidden" name="PlanId" value="@p.Id"/><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/><input class="short" type="number" name="Quantity" min="1" max="@p.Target" placeholder="Số tiêm" required/><input class="short" name="Lot" placeholder="Số lô" required/><button class="small">Báo đã làm</button></form>}</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>Các lần tiêm (chờ hoặc đã duyệt)</h2><div class="table-wrap"><table><thead><tr><th>Kế hoạch</th><th>Số lượng</th><th>Số lô</th><th>Thời điểm</th><th>Xác nhận</th></tr></thead><tbody>@foreach(var e in events.OrderByDescending(x=>x.PerformedAt)){<tr><td class="mono">@(e.PlanId.ToString()[..8])</td><td>@e.Quantity</td><td>@e.Lot</td><td>@e.PerformedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@if(e.ApprovedBy!=null){<span class="pill">Đã duyệt</span>}else if(!User.IsInRole(Roles.Employee)){<form asp-action="Approve" method="post"><input type="hidden" name="id" value="@e.Id"/><button class="small">Duyệt</button></form>}else{<span class="pill warn">Chờ duyệt</span>}</td></tr>}</tbody></table></div></section>
@if(!User.IsInRole(Roles.Employee)){<section class="panel"><h2>Điều chỉnh / hủy lịch (có lý do)</h2><form asp-action="Adjust" method="post"><div class="form-grid"><label>Lịch<select name="id">@foreach(var p in plans.Where(p=>p.Status is "PLANNED" or "PARTIAL")){<option value="@p.Id">@p.PlannedDate – @(herds.FirstOrDefault(h=>h.Id==p.HerdId)?.Code)</option>}</select></label><label>Ngày mới<input type="date" name="newDate" /></label><label>Lý do<input name="reason" required /></label><label>Hủy lịch?<select name="cancel"><option value="false">Không, dời lịch</option><option value="true">Có, hủy phần còn lại</option></select></label></div><button class="light">Lưu điều chỉnh</button></form></section>}

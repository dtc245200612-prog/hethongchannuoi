@{ViewData["Title"]="Sinh sản";var herds=(List<Herd>)ViewBag.Herds;var animals=(List<Animal>)ViewBag.Animals;var events=(List<ReproductionEvent>)ViewBag.Events;}
<h1>Sinh sản và cá thể mẹ</h1><p class="lead">Ghi nhận con sinh sống và số con thực tế tiếp nhận, có khóa chống ghi tăng trùng.</p>
@if(!User.IsInRole(Roles.Employee)){<div class="grid2"><section class="panel"><h2>Thêm cá thể sinh sản</h2><form asp-action="Animal" method="post"><div class="form-grid"><label>Đàn<select name="HerdId">@foreach(var h in herds){<option value="@h.Id">@h.Code</option>}</select></label><label>Mã tai<input name="Tag" required /></label><label>Giới tính<select name="Sex"><option value="FEMALE">Cái</option><option value="MALE">Đực</option></select></label></div><button>Thêm cá thể</button></form></section>
<section class="panel"><h2>Ghi sự kiện sinh sản</h2><form asp-action="Birth" method="post"><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/><div class="form-grid"><label>Cá thể mẹ<select name="MotherId">@foreach(var a in animals.Where(a=>a.Sex=="FEMALE")){<option value="@a.Id">@a.Tag</option>}</select></label><label>Đàn tiếp nhận<select name="TargetHerdId">@foreach(var h in herds){<option value="@h.Id">@h.Code</option>}</select></label><label>Sinh sống<input type="number" min="0" name="LiveBorn" required /></label><label>Chết lưu<input type="number" min="0" name="StillBorn" required /></label><label>Tiếp nhận<input type="number" min="0" name="Accepted" required /></label></div><button>Xác nhận sinh và nhập đàn</button></form></section></div>}
<section class="panel"><h2>Lịch sử sinh sản</h2><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Cá thể mẹ</th><th>Đàn tiếp nhận</th><th>Sinh sống</th><th>Chết lưu</th><th>Tiếp nhận</th></tr></thead><tbody>@foreach(var e in events){<tr><td>@e.EventDate</td><td>@(animals.FirstOrDefault(a=>a.Id==e.MotherId)?.Tag ?? "-")</td><td>@(herds.FirstOrDefault(h=>h.Id==e.TargetHerdId)?.Code ?? "-")</td><td>@e.LiveBorn</td><td>@e.StillBorn</td><td>@e.Accepted</td></tr>}</tbody></table></div></section>

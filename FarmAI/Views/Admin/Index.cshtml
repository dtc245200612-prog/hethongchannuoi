@{ViewData["Title"]="Quản trị";var users=(List<AppUser>)ViewBag.Users;var barns=(List<Barn>)ViewBag.Barns;var assignments=(List<Assignment>)ViewBag.Assignments;var audits=(List<AuditLog>)ViewBag.Audits;}
<h1>Quản lý tài khoản, phân quyền và kiểm toán</h1><p class="lead">Vai trò và phân công được kiểm tra lại tại máy chủ trong mỗi yêu cầu.</p>
<section class="panel"><h2>Tạo tài khoản</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Username<input name="Username" required /></label><label>Mật khẩu (tối thiểu 8 ký tự)<input type="password" name="Password" minlength="8" required /></label><label>Vai trò<select name="Role"><option value="EMPLOYEE">Nhân viên</option><option value="TECHNICIAN">Kỹ thuật viên</option><option value="MANAGER">Quản lý</option></select></label></div><button>Tạo tài khoản</button></form></section>
<section class="panel"><h2>Danh sách tài khoản</h2><div class="table-wrap"><table><thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>@foreach(var u in users){<tr><td>@u.Username</td><td>@u.Role</td><td><span class="pill @(u.Active?"":"bad")">@(u.Active?"Hoạt động":"Đã khóa")</span></td><td><form asp-action="ChangeUser" method="post" class="action-row"><input name="id" type="hidden" value="@u.Id"/><select name="role" class="short"><option selected="@(u.Role==Roles.Employee)" value="EMPLOYEE">Nhân viên</option><option selected="@(u.Role==Roles.Technician)" value="TECHNICIAN">Kỹ thuật viên</option><option selected="@(u.Role==Roles.Manager)" value="MANAGER">Quản lý</option></select><select name="active" class="short"><option selected="@u.Active" value="true">Kích hoạt</option><option selected="@(!u.Active)" value="false">Khóa</option></select><button class="small light">Lưu</button></form></td></tr>}</tbody></table></div></section>
<section class="panel"><h2>Phân công chuồng cho nhân viên/kỹ thuật viên</h2><form asp-action="Assign" method="post"><div class="form-grid"><label>Người dùng<select name="userId">@foreach(var u in users){<option value="@u.Id">@u.Username</option>}</select></label><label>Chuồng<select name="barnId">@foreach(var b in barns){<option value="@b.Id">@b.Code – @b.Name</option>}</select></label><label>Thao tác<select name="remove"><option value="false">Gán quyền</option><option value="true">Thu hồi</option></select></label></div><button>Lưu phân công</button></form><p class="subtle">Phân công hiện hành: @string.Join(" | ",assignments.Select(a=>(users.FirstOrDefault(x=>x.Id==a.UserId)?.Username??"?")+": "+(barns.FirstOrDefault(b=>b.Id==a.BarnId)?.Code??"?")))</p></section>
<section class="panel"><h2>Audit 80 sự kiện gần nhất</h2><div class="table-wrap"><table><thead><tr><th>Thời gian</th><th>Hành động</th><th>Đối tượng</th><th>Người thực hiện</th></tr></thead><tbody>@foreach(var a in audits){<tr><td>@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@a.Action</td><td class="mono">@a.EntityType / @(a.EntityId.ToString()[..8])</td><td>@(users.FirstOrDefault(u=>u.Id==a.ActorId)?.Username??"SYSTEM")</td></tr>}</tbody></table></div></section>

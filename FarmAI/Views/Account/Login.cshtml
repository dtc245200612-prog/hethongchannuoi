@model LoginForm
@{ ViewData["Title"]="Đăng nhập"; }
<div class="panel login-box"><h1>Chào mừng đến FarmAI</h1><p class="lead">Đăng nhập để quản lý dữ liệu chăn nuôi.</p>
<form asp-action="Login" method="post">
<div asp-validation-summary="All" class="alert error"></div>
<div class="form-grid"><label>Tên đăng nhập<input asp-for="Username" autocomplete="username" required /></label><label>Mật khẩu<input asp-for="Password" type="password" autocomplete="current-password" required /></label></div>
<button style="width:100%">Đăng nhập</button></form>
<p class="subtle">Môi trường demo: quanly / kythuat / nhanvien. Mật khẩu phát qua hướng dẫn README.</p></div>

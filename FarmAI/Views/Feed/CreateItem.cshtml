@model FeedItem
@{ ViewData["Title"] = "Thêm thức ăn vào kho"; }
<article class="panel form-card"><form asp-action="CreateItem" method="post">
<div asp-validation-summary="ModelOnly"></div>
<div class="form-grid">
<div class="field"><label asp-for="Name"></label><input asp-for="Name" /></div>
<div class="field"><label asp-for="Unit"></label><input asp-for="Unit" placeholder="kg" /></div>
<div class="field"><label asp-for="Quantity"></label><input asp-for="Quantity" step="0.1" /></div>
<div class="field"><label asp-for="MinimumStock"></label><input asp-for="MinimumStock" step="0.1" /></div>
<div class="field"><label asp-for="UnitCost"></label><input asp-for="UnitCost" step="1" /></div>
</div>
<div class="form-actions"><button class="btn btn-primary">Lưu mặt hàng</button><a class="btn btn-outline" asp-action="Index">Hủy</a></div>
</form></article>

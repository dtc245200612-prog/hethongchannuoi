@{var s=(Sale)ViewBag.Sale;var herds=(List<Herd>)ViewBag.Herds;var total=s.Lines.Sum(l=>l.Amount);var paid=s.Payments.Sum(p=>p.Amount);ViewData["Title"]="Phiếu bán";}
<a asp-action="Index">← Danh sách phiếu</a><h1>Phiếu bán · @s.CustomerName</h1><p class="lead">@s.Id · <span class="pill @(s.Status=="DRAFT"?"warn":"")">@s.Status</span></p>
<div class="stats"><div class="stat"><label>Tổng tiền</label><strong>@total.ToString("N0") đ</strong></div><div class="stat"><label>Đã thu</label><strong>@paid.ToString("N0") đ</strong></div><div class="stat"><label>Còn phải thu</label><strong>@(total-paid).ToString("N0") đ</strong></div></div>
<section class="panel"><h2>Các dòng bán</h2><div class="table-wrap"><table><thead><tr><th>Đàn</th><th>Con</th><th>Trọng lượng</th><th>Cơ sở giá</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var l in s.Lines){<tr><td>@(herds.FirstOrDefault(h=>h.Id==l.HerdId)?.Code ?? "-")</td><td>@l.Quantity</td><td>@l.WeightKg</td><td>@l.Basis</td><td>@l.UnitPrice.ToString("N0") đ</td><td>@l.Amount.ToString("N0") đ</td></tr>}</tbody></table></div></section>
@if(s.Status=="DRAFT"){
<section class="panel"><h2>Thêm dòng bán</h2><form asp-action="AddLine" method="post"><input type="hidden" name="SaleId" value="@s.Id"/><div class="form-grid"><label>Đàn<select name="HerdId">@foreach(var h in herds){<option value="@h.Id">@h.Code – @h.Quantity con</option>}</select></label><label>Con<input name="Quantity" type="number" min="1" required /></label><label>Trọng lượng kg<input name="WeightKg" type="number" min="0.001" step="0.001" /></label><label>Cơ sở<select name="Basis"><option value="HEAD">HEAD</option><option value="KG">KG</option></select></label><label>Đơn giá<input name="UnitPrice" type="number" min="1" step="0.01" required /></label></div><button class="light">Thêm dòng</button></form></section>
<section class="panel"><h2>Xác nhận xuất bán</h2><p class="warning">Hành động này giảm số lượng đàn trong một giao dịch. Không thể sửa phiếu đã xác nhận.</p><form asp-action="Confirm" method="post"><input type="hidden" name="id" value="@s.Id"/><input type="hidden" name="key" value="@Guid.NewGuid()"/><button>Xác nhận và ghi xuất đàn</button></form></section>
}else if(s.Status=="CONFIRMED"){
<section class="panel"><h2>Thanh toán</h2><form asp-action="Pay" method="post"><input type="hidden" name="SaleId" value="@s.Id"/><div class="form-grid"><label>Số tiền thu (VND)<input name="Amount" type="number" min="1" step="0.01" max="@(total-paid)" required /></label><label>Phương thức<select name="Method"><option value="CASH">Tiền mặt</option><option value="TRANSFER">Chuyển khoản</option></select></label><label>Tham chiếu<input name="Reference" /></label></div><button>Ghi nhận thu tiền</button></form><div class="table-wrap"><table><thead><tr><th>Ngày thu</th><th>Số tiền</th><th>Phương thức</th><th>Tham chiếu</th></tr></thead><tbody>@foreach(var p in s.Payments){<tr><td>@p.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@p.Amount.ToString("N0") đ</td><td>@p.Method</td><td>@p.Reference</td></tr>}</tbody></table></div></section>}

@{ViewData["Title"]="Xuất bán";var herds=(List<Herd>)ViewBag.Herds;var sales=(List<Sale>)ViewBag.Sales;}
<h1>Xuất bán và công nợ</h1><p class="lead">Lưu nháp không giảm đàn; chỉ khi xác nhận mới cập nhật số lượng và audit.</p>
<section class="panel"><h2>Tạo phiếu bán nháp</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Khách hàng<input name="CustomerName" required /></label><label>Đàn<select name="HerdId">@foreach(var h in herds){<option value="@h.Id">@h.Code – còn @h.Quantity con</option>}</select></label><label>Số con<input type="number" name="Quantity" min="1" required /></label><label>Cơ sở tính tiền<select name="Basis"><option value="HEAD">Theo con</option><option value="KG">Theo kg</option></select></label><label>Tổng trọng lượng kg (nếu theo kg)<input type="number" min="0.001" step="0.001" name="WeightKg" /></label><label>Đơn giá (VND)<input type="number" name="UnitPrice" min="1" step="0.01" required /></label></div><button>Tạo phiếu nháp</button></form></section>
<section class="panel"><h2>Danh sách phiếu bán</h2><div class="table-wrap"><table><thead><tr><th>Khách hàng</th><th>Ngày tạo</th><th>Số dòng</th><th>Thành tiền</th><th>Đã thu</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var s in sales){<tr><td><a asp-action="Details" asp-route-id="@s.Id">@s.CustomerName</a></td><td>@s.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@s.Lines.Count</td><td>@s.Lines.Sum(l=>l.Amount).ToString("N0") đ</td><td>@s.Payments.Sum(p=>p.Amount).ToString("N0") đ</td><td><span class="pill @(s.Status=="DRAFT"?"warn":"")">@s.Status</span></td></tr>}</tbody></table></div></section>

@using System.Text.Json
@{
    ViewData["Title"] = "Trang chủ";
    var herds = (List<Herd>)ViewBag.Herds;
    var plans = (List<VaccinationPlan>)ViewBag.Plans;
    var notices = (List<FarmNotification>)ViewBag.Notices;
    using var json = JsonDocument.Parse((string)ViewBag.Summary);
    var data = json.RootElement;
}
<div class="dashboard-hero">
    <div class="hero-copy">
        <span class="hero-eyebrow"><span class="hero-eyebrow-dot"></span> FARM MANAGEMENT DASHBOARD</span>
        <h1>Chăm sóc tốt hơn.<br /><em>Quản lý thông minh hơn.</em></h1>
        <p>Toàn cảnh trang trại của bạn trong một nơi – quản lý đàn, theo dõi lịch chăm sóc và đưa ra quyết định dựa trên dữ liệu.</p>
        <div class="hero-actions">
            <a class="hero-btn-primary" asp-controller="Herds" asp-action="Index">Khám phá đàn nuôi <svg class="icon"><use href="#i-arrow-right"></use></svg></a>
            <a class="hero-btn-outline" asp-controller="Chat" asp-action="Index"><svg class="icon"><use href="#i-sparkles"></use></svg> Hỏi trợ lý AI</a>
        </div>
        <span class="hero-caption">✳ Hệ thống quản lý chăn nuôi tích hợp AI</span>
    </div>
    <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 520 310" xmlns="http://www.w3.org/2000/svg" role="img" focusable="false">
            <defs>
                <linearGradient id="field-grad" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#B7DC83"/><stop offset="1" stop-color="#72BC86"/></linearGradient>
                <linearGradient id="barn-grad" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#F7E7B5"/><stop offset="1" stop-color="#E9C992"/></linearGradient>
            </defs>
            <circle cx="376" cy="69" r="44" fill="#F8DA82" opacity=".9"/>
            <g fill="#F1F8DA" opacity=".8"><ellipse cx="94" cy="76" rx="45" ry="13"/><ellipse cx="120" cy="68" rx="26" ry="19"/><ellipse cx="450" cy="109" rx="39" ry="11"/><ellipse cx="423" cy="100" rx="20" ry="15"/></g>
            <path d="M-5 206C97 145 173 176 272 188c88 11 155-17 259-34v159H-5Z" fill="#62A98D"/>
            <path d="M-5 225c120-15 157 19 251 15 101-4 181-43 285-16v87H-5Z" fill="url(#field-grad)"/>
            <path d="M-5 270c105-46 175 7 278-7s173-1 258-23v70H-5Z" fill="#9CCC70"/>
            <g opacity=".72" stroke="#E9F5BE" stroke-width="2"><path d="m10 277 71-26M48 292l74-37M294 283l133-28M314 304l159-38"/></g>
            <g transform="translate(168 83)">
                <path d="m0 80 92-72 93 72" fill="#265B4A" stroke="#C7E6B4" stroke-width="7" stroke-linejoin="round"/>
                <path d="M15 79h155v133H15z" fill="url(#barn-grad)"/>
                <path d="M0 80 92 8l93 72" fill="none" stroke="#356B55" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="70" y="129" width="47" height="83" rx="5" fill="#285B47"/><path d="M93.5 129v83" stroke="#92BB92" stroke-width="3"/>
                <rect x="33" y="110" width="25" height="28" rx="3" fill="#A4D5A9" stroke="#426851" stroke-width="5"/>
                <rect x="128" y="110" width="25" height="28" rx="3" fill="#A4D5A9" stroke="#426851" stroke-width="5"/>
                <circle cx="92" cy="66" r="14" fill="#E4F1C2"/><path d="M92 53v26M79 66h26" stroke="#38735A" stroke-width="3"/>
            </g>
            <g transform="translate(377 125)"><rect x="12" y="15" width="62" height="144" rx="5" fill="#D4E5C3"/><ellipse cx="43" cy="15" rx="31" ry="11" fill="#E8F2DA"/><path d="m5 14 38-49 38 49" fill="#E5C987" stroke="#EED9A1" stroke-width="5" stroke-linejoin="round"/><rect x="27" y="102" width="25" height="57" fill="#78B59A"/></g>
            <g stroke="#F1EDD0" stroke-width="6" stroke-linecap="round"><path d="M38 237v40M77 231v47M116 230v47M37 251h94M37 265h94"/><path d="M351 252v36M392 251v38M435 247v43M349 265h94M349 279h94"/></g>
            <g transform="translate(30 210)"><ellipse cx="47" cy="56" rx="31" ry="12" fill="#55835D" opacity=".25"/><ellipse cx="41" cy="23" rx="37" ry="24" fill="#FFF9DF"/><circle cx="69" cy="12" r="16" fill="#FFF9DF"/><ellipse cx="80" cy="17" rx="10" ry="8" fill="#FFEFC8"/><circle cx="75" cy="8" r="2.3" fill="#285846"/><path d="M17 40v18m37-18v18" stroke="#F3E3BF" stroke-width="8" stroke-linecap="round"/></g>
            <g transform="translate(438 220)"><ellipse cx="23" cy="48" rx="30" ry="8" fill="#51805A" opacity=".3"/><ellipse cx="20" cy="27" rx="27" ry="19" fill="#FCECC9"/><circle cx="39" cy="18" r="13" fill="#FCECC9"/><path d="M11 12c-9-9-13-4-9 5M49 11c9-6 14-3 10 7" fill="#E7A8A3"/><circle cx="43" cy="17" r="2" fill="#4D6E57"/></g>
            <g fill="#316F52"><path d="M151 254c-15-27-21-39-22-53 16 6 25 19 22 53ZM154 256c12-26 20-32 31-35-1 22-13 30-31 35Z"/><path d="M460 264c-15-24-22-35-24-49 17 6 26 19 24 49ZM461 262c10-19 18-25 31-29-1 19-12 26-31 29Z"/></g>
            <g fill="#F9E6A8" opacity=".9"><circle cx="32" cy="124" r="3"/><circle cx="140" cy="50" r="3"/><circle cx="472" cy="57" r="4"/><circle cx="503" cy="143" r="3"/></g>
        </svg>
        <div class="hero-art-label"><span class="art-label-dot"></span> Tăng trưởng bền vững</div>
    </div>
</div>

<div class="section-heading"><div><span class="section-kicker">SỐ LIỆU TỔNG QUAN</span><h2>Trang trại hôm nay</h2></div><span class="section-hint">Dữ liệu trong phạm vi của bạn</span></div>
<div class="stats">
    <div class="stat stat-herds"><div class="stat-top"><span class="stat-icon">🐄</span><span class="stat-tag">ĐÀN NUÔI</span></div><label>Tổng số đàn</label><strong>@data.GetProperty("herdCount")</strong><small>Đàn đang được quản lý</small></div>
    <div class="stat stat-animals"><div class="stat-top"><span class="stat-icon">🌿</span><span class="stat-tag">VẬT NUÔI</span></div><label>Tổng vật nuôi</label><strong>@data.GetProperty("animalCount")</strong><small>Con trong các đàn hiện có</small></div>
    <div class="stat stat-deaths"><div class="stat-top"><span class="stat-icon">🩺</span><span class="stat-tag">30 NGÀY</span></div><label>Hao hụt ghi nhận</label><strong>@data.GetProperty("deaths")</strong><small>Con trong 30 ngày gần đây</small></div>
    <div class="stat stat-plans"><div class="stat-top"><span class="stat-icon">📅</span><span class="stat-tag">LỊCH VIỆC</span></div><label>Lịch chưa hoàn tất</label><strong>@plans.Count</strong><small>Lịch cần theo dõi</small></div>
</div>

<div class="section-heading"><div><span class="section-kicker">THEO DÕI VẬN HÀNH</span><h2>Dữ liệu cần quan tâm</h2></div></div>
<div class="grid2 dashboard-grid">
    <section class="panel dashboard-list-panel"><div class="panel-head"><div><span class="panel-icon panel-icon-herd"><svg class="icon"><use href="#i-herd"></use></svg></span><h2>Đàn chăn nuôi</h2></div><a class="panel-more" asp-controller="Herds" asp-action="Index">Xem tất cả <span>→</span></a></div>
        <div class="table-wrap"><table><thead><tr><th>Mã đàn</th><th>Tên đàn</th><th>Loài</th><th>Số lượng</th></tr></thead><tbody>
            @foreach(var h in herds){<tr><td><a asp-controller="Herds" asp-action="Details" asp-route-id="@h.Id"><strong>@h.Code</strong></a></td><td>@h.Name</td><td>@h.Species</td><td><span class="quantity-chip">@h.Quantity con</span></td></tr>}
            @if(herds.Count == 0){<tr><td colspan="4" class="empty-cell">Chưa có đàn trong phạm vi được giao.</td></tr>}
        </tbody></table></div>
    </section>
    <section class="panel dashboard-list-panel"><div class="panel-head"><div><span class="panel-icon panel-icon-calendar"><svg class="icon"><use href="#i-vaccine"></use></svg></span><h2>Lịch tiêm phòng</h2></div><a class="panel-more" asp-controller="Vaccinations" asp-action="Index">Xem lịch <span>→</span></a></div>
        <div class="table-wrap"><table><thead><tr><th>Ngày dự kiến</th><th>Mục tiêu</th><th>Trạng thái</th></tr></thead><tbody>
            @foreach(var p in plans){<tr><td>@p.PlannedDate.ToString("dd/MM/yyyy")</td><td><strong>@p.Target con</strong></td><td><span class="pill warn">@p.Status</span></td></tr>}
            @if(plans.Count == 0){<tr><td colspan="3" class="empty-cell">Chưa có lịch tiêm cần theo dõi.</td></tr>}
        </tbody></table></div>
    </section>
</div>

<div class="dashboard-bottom-grid">
    <section class="panel notices-panel"><div class="panel-head"><div><span class="panel-icon panel-icon-notice">☼</span><h2>Nhắc việc gần đây</h2></div><a class="panel-more" asp-controller="Vaccinations" asp-action="Index">Chi tiết <span>→</span></a></div>
        @if(notices.Count == 0){<div class="empty-notice"><span>✓</span><strong>Không có thông báo mới</strong><small>Các nhắc việc sẽ hiển thị tại đây khi được tạo.</small></div>}
        @foreach(var n in notices){<div class="note dashboard-notice"><span class="pill @(n.Kind == "OVERDUE" ? "bad" : "warn")">@n.Kind</span><span>@n.Message</span></div>}
    </section>
    <section class="ai-feature"><div class="ai-feature-stars" aria-hidden="true">✦</div><div class="ai-feature-icon"><svg class="icon"><use href="#i-sparkles"></use></svg></div><span class="ai-feature-kicker">FARMAI AI ASSISTANT</span><h2>Trợ lý chăn nuôi<br />luôn đồng hành</h2><p>Hỏi về đàn nuôi, lịch tiêm, cân đo và nhận gợi ý dựa trên dữ liệu trang trại.</p><a asp-controller="Chat" asp-action="Index">Bắt đầu trò chuyện <svg class="icon"><use href="#i-arrow-right"></use></svg></a></section>
</div>

@{ViewData["Title"]="Nhật ký chăm sóc";var herds=(List<Herd>)ViewBag.Herds;var logs=(List<CareLog>)ViewBag.Entries;}
<h1>Nhật ký thức ăn, thuốc và chăm sóc</h1><p class="lead">Nhật ký chờ xác nhận; chi phí chỉ tổng hợp từ bản đã duyệt.</p>
<section class="panel"><h2>Ghi nhật ký mới</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Đàn<select name="HerdId">@foreach(var h in herds){<option value="@h.Id">@h.Code – @h.Name</option>}</select></label><label>Loại<select name="Kind"><option value="FEED">Thức ăn (đã cấp)</option><option value="MEDICINE">Thuốc</option><option value="OBSERVATION">Theo dõi</option></select></label><label>Tên vật tư<input name="ItemName" required /></label><label>Số lượng<input name="Quantity" type="number" min="0.001" step="0.001" required /></label><label>Đơn vị<input name="Unit" value="kg" required /></label><label>Đơn giá (có thể bỏ trống)<input name="UnitPrice" type="number" min="0" step="0.01" /></label><label>Căn cứ (bắt buộc nếu thuốc)<input name="Reference" /></label><label>Ghi chú<input name="Note" /></label></div><button>Ghi nhật ký chờ duyệt</button></form></section>
<section class="panel"><h2>Nhật ký gần đây</h2><div class="table-wrap"><table><thead><tr><th>Đàn</th><th>Loại</th><th>Vật tư</th><th>Lượng</th><th>Chi phí</th><th>Thời gian</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var l in logs){<tr><td>@(herds.FirstOrDefault(x=>x.Id==l.HerdId)?.Code ?? "-")</td><td>@l.Kind</td><td>@l.ItemName</td><td>@l.Quantity @l.Unit</td><td>@(l.Cost.HasValue?l.Cost.Value.ToString("N0")+" đ":"Chưa có giá")</td><td>@l.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@if(l.Status=="APPROVED"){<span class="pill">Đã duyệt</span>}else if(!User.IsInRole(Roles.Employee)){<form asp-action="Approve" method="post"><input type="hidden" name="id" value="@l.Id"/><button class="small">Xác nhận</button></form>}else{<span class="pill warn">Chờ duyệt</span>}</td></tr>}</tbody></table></div></section>

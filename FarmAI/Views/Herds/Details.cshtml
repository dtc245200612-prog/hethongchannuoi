@{var h=(Herd)ViewBag.Herd;var barns=(List<Barn>)ViewBag.Barns;var movements=(List<HerdMovement>)ViewBag.Movements;var allocations=(List<Allocation>)ViewBag.Allocations;ViewData["Title"]=$"Đàn {h.Code}";}
<a asp-action="Index">← Quay lại danh sách</a><h1>@h.Code · @h.Name</h1><p class="lead">@h.Species · @h.Breed · @h.Quantity con · Phiên bản @h.Version</p>
<div class="stats"><div class="stat"><label>Số lượng hiện tại</label><strong>@h.Quantity</strong></div><div class="stat"><label>Ngày tiếp nhận</label><strong style="font-size:22px">@h.ReceivedDate.ToString("dd/MM/yyyy")</strong></div><div class="stat"><label>Chuồng hiện tại</label><strong style="font-size:22px">@(barns.FirstOrDefault(b=>b.Id==h.BarnId)?.Code ?? "-")</strong></div></div>
@if(!User.IsInRole(Roles.Employee)){
<section class="panel"><h2>Thông tin mô tả đàn</h2><form asp-action="Edit" method="post"><input type="hidden" name="id" value="@h.Id"/><div class="form-grid"><label>Tên đàn<input name="name" value="@h.Name" required /></label><label>Giống<input name="breed" value="@h.Breed" /></label><label>Mục đích<input name="purpose" value="@h.Purpose" /></label></div><button class="light">Lưu mô tả</button></form></section>
<div class="grid2"><section class="panel"><h2>Chuyển toàn bộ đàn</h2><form asp-action="Transfer" method="post"><input type="hidden" name="HerdId" value="@h.Id"/><input type="hidden" name="Version" value="@h.Version"/><div class="form-grid"><label>Chuồng đích<select name="TargetBarnId">@foreach(var b in barns.Where(x=>x.Id!=h.BarnId)){<option value="@b.Id">@b.Code – @b.Name</option>}</select></label></div><button>Chuyển chuồng</button></form></section>
<section class="panel"><h2>Chia đàn sang đàn đã có</h2><form asp-action="Split" method="post"><input type="hidden" name="SourceHerdId" value="@h.Id"/><div class="form-grid"><label>ID đàn đích<input type="text" name="TargetHerdId" placeholder="Dán ID đàn đích" required /></label><label>Số lượng<input type="number" min="1" name="Quantity" required /></label></div><button>Chia và bảo toàn tổng</button></form></section></div>}
<section class="panel"><h2>Báo hao hụt / Điều chỉnh có lý do</h2><form asp-action="Movement" method="post"><input type="hidden" name="HerdId" value="@h.Id"/><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/><div class="form-grid"><label>Loại<select name="Kind"><option value="DEATH">Hao hụt</option><option value="ADJUSTMENT">Điều chỉnh</option></select></label><label>Chênh lệch (+/-)<input type="number" name="Delta" value="-1" required /></label><label>Lý do<input name="Reason" required /></label></div><button>Gửi biến động</button></form><p class="subtle">Nhân viên gửi chờ duyệt; quản lý có thể xác nhận trực tiếp.</p></section>
<div class="grid2"><section class="panel"><h2>Biến động số lượng</h2><div class="table-wrap"><table><thead><tr><th>Loại</th><th>Chênh lệch</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>@foreach(var m in movements){<tr><td>@m.Kind</td><td>@m.Delta</td><td>@if(m.Approved){<span class="pill">Đã duyệt</span>}else if(User.IsInRole(Roles.Manager)){<form asp-action="ApproveMovement" method="post"><input type="hidden" name="id" value="@m.Id"/><input type="hidden" name="herdId" value="@h.Id"/><button class="small">Duyệt</button></form>}else{<span class="pill warn">Chờ duyệt</span>}</td><td>@m.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div></section><section class="panel"><h2>Lịch sử phân bổ chuồng</h2><div class="table-wrap"><table><thead><tr><th>Chuồng</th><th>Bắt đầu</th><th>Kết thúc</th></tr></thead><tbody>@foreach(var a in allocations){<tr><td>@(barns.FirstOrDefault(b=>b.Id==a.BarnId)?.Code ?? "-")</td><td>@a.FromAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@(a.UntilAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Đang ở")</td></tr>}</tbody></table></div></section></div>
<div class="note mono">Mã nội bộ của đàn (dùng để chia đàn): @h.Id</div>

@if(User.IsInRole(Roles.Manager)&&h.Quantity==0&&h.Status=="ACTIVE"){<section class="panel"><h2>Kết thúc đợt nuôi</h2><form asp-action="Archive" method="post"><input type="hidden" name="id" value="@h.Id"/><button class="danger">Lưu trữ đàn hết vật nuôi</button></form></section>}

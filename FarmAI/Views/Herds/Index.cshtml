@{ViewData["Title"]="Quản lý đàn";var herds=(List<Herd>)ViewBag.Herds;var barns=(List<Barn>)ViewBag.Barns;}
<div class="row between"><div><h1>Quản lý đàn</h1><p class="lead">Tạo hồ sơ, chuyển chuồng, chia đàn và đối soát số lượng.</p></div><span class="pill">@ViewBag.Total kết quả</span></div>
@if(!User.IsInRole(Roles.Employee)){<section class="panel"><h2>Tiếp nhận đàn mới</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Mã đàn<input name="Code" required placeholder="D03"/></label><label>Tên đàn<input name="Name" required/></label><label>Loài<input name="Species" value="Heo" required/></label><label>Giống<input name="Breed" /></label><label>Mục đích<input name="Purpose" value="Thương phẩm"/></label><label>Chuồng<select name="BarnId" required>@foreach(var b in barns){<option value="@b.Id">@b.Code – @b.Name</option>}</select></label><label>Số con nhập<input type="number" name="Quantity" min="1" required/></label></div><button>Tạo đàn và ghi biến động nhập</button></form></section>}
<section class="panel"><div class="row between"><h2>Danh sách đàn</h2><form asp-action="Index" method="get" class="action-row"><input class="short" name="q" placeholder="Mã hoặc tên đàn" value="@ViewBag.Query"/><select class="short" name="barn"><option value="">Tất cả chuồng</option>@foreach(var b in barns){<option value="@b.Id">@b.Code</option>}</select><button class="light">Lọc</button></form></div><div class="table-wrap"><table><thead><tr><th>Mã đàn</th><th>Tên</th><th>Loài</th><th>Chuồng</th><th>Số lượng</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var h in herds){<tr><td><a asp-action="Details" asp-route-id="@h.Id"><strong>@h.Code</strong></a></td><td>@h.Name</td><td>@h.Species</td><td>@(barns.FirstOrDefault(b=>b.Id==h.BarnId)?.Code ?? "-")</td><td><strong>@h.Quantity</strong></td><td><span class="pill">@h.Status</span></td></tr>}</tbody></table></div><div class="row" style="margin-top:15px"><span>Trang @ViewBag.Page</span>@if(ViewBag.Page>1){<a class="btn light" asp-action="Index" asp-route-page="@(ViewBag.Page-1)" asp-route-q="@ViewBag.Query">← Trước</a>}@if(ViewBag.Total>ViewBag.Page*20){<a class="btn light" asp-action="Index" asp-route-page="@(ViewBag.Page+1)" asp-route-q="@ViewBag.Query">Tiếp →</a>}</div></section>

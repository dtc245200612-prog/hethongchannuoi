@model Barn
@{
    ViewData["Title"] = "Cập nhật chuồng trại";
}
<article class="panel form-card">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly"></div>
<div class="form-grid">
<div class="field"><label asp-for="Code"></label><input asp-for="Code" /></div>
<div class="field"><label asp-for="Name"></label><input asp-for="Name" /></div>
<div class="field"><label asp-for="Capacity"></label><input asp-for="Capacity" /></div>
<div class="field"><label asp-for="Temperature"></label><input asp-for="Temperature" step="0.1" /></div>
<div class="field"><label asp-for="Humidity"></label><input asp-for="Humidity" /></div>
<div class="field"><label asp-for="Status"></label><select asp-for="Status"><option>Tốt</option><option>Cần theo dõi</option><option>Bảo trì</option></select></div>
<div class="field full"><label asp-for="Notes"></label><textarea asp-for="Notes"></textarea></div>
</div>
<div class="form-actions"><button class="btn btn-primary">Lưu thay đổi</button><a class="btn btn-outline" asp-action="Index">Quay lại</a></div>
</form>
</article>

@{ViewData["Title"]="Quản lý chuồng";var barns=(List<Barn>)ViewBag.Barns;}
<h1>Quản lý chuồng</h1><p class="lead">Sức chứa, loài phù hợp và trạng thái khai thác.</p>
@if(User.IsInRole(Roles.Manager)){<section class="panel"><h2>Thêm chuồng mới</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Mã chuồng<input name="Code" required maxlength="32" placeholder="C03" /></label><label>Tên chuồng<input name="Name" required /></label><label>Loài phù hợp<input name="Species" value="Heo" required /></label><label>Sức chứa<input type="number" min="1" name="Capacity" required /></label></div><button>Thêm chuồng</button></form></section>}
<section class="panel"><h2>Danh sách chuồng</h2><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Tên</th><th>Loài</th><th>Sức chứa</th><th>Trạng thái / cập nhật</th></tr></thead><tbody>@foreach(var b in barns){<tr><td><strong>@b.Code</strong></td><td>@b.Name</td><td>@b.Species</td><td>@b.Capacity con</td><td>@if(User.IsInRole(Roles.Manager)){<form asp-action="Update" method="post" class="action-row"><input type="hidden" name="id" value="@b.Id"/><input class="short" type="number" min="1" name="capacity" value="@b.Capacity"/><select class="short" name="status"><option selected="@(b.Status=="ACTIVE")" value="ACTIVE">Đang dùng</option><option selected="@(b.Status=="MAINTENANCE")" value="MAINTENANCE">Bảo trì</option><option selected="@(b.Status=="ARCHIVED")" value="ARCHIVED">Lưu trữ</option></select><button class="small light">Lưu</button></form>}else{<span class="pill">@b.Status</span>}</td></tr>}</tbody></table></div></section>

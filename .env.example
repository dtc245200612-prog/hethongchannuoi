# Cấu hình ví dụ – KHÔNG điền khóa thật vào file này và không commit secrets.
FarmAI__DbProvider=SqlServer
# AI chatbot mặc định là OpenAI với model gpt-4.1-mini.
AI__ChatProvider=OpenAI
AI__ChatModel=gpt-4.1-mini
AI__ReportProvider=OpenAI
AI__ReportModel=gpt-4.1-mini
# OPENAI_API_KEY: đặt bằng Visual Studio -> FarmAI -> Manage User Secrets,
# hoặc trong biến môi trường riêng trên máy chủ (KHÔNG ghi key vào ZIP).
# Có thể chuyển lại AI__ChatProvider=Ollama + AI__ChatModel=llama3.2:3b
# và AI__BaseUrl=http://localhost:11434 nếu không dùng cloud.
